101:export function recentMessagesForChat(
102:  conversationId: string,
103:  limit = 50,
104:): Array<Pick<Message, 'role' | 'content'>> {
105:  return db
106:    .select({ role: messages.role, content: messages.content })
107:    .from(messages)
108:    .where(and(eq(messages.conversationId, conversationId)))
109:    .orderBy(messages.createdAt)
110:    .limit(limit)
111:    .all()
112:}
