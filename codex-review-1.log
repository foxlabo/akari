1:/**
2: * Integration tests for DB query helpers.
3: *
4: * We use an in-memory SQLite to avoid touching the dev DB file.
5: * The schema is applied at runtime via Drizzle's better-sqlite3 dialect.
6: */
7:import Database from 'better-sqlite3'
8:import { drizzle } from 'drizzle-orm/better-sqlite3'
9:import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
10:
11:import * as schema from '@/lib/db/schema'
12:
13:type Db = ReturnType<typeof drizzle>
14:
15:function buildInMemoryDb(): Db {
16:  const sqlite = new Database(':memory:')
17:  sqlite.pragma('foreign_keys = ON')
18:  sqlite.exec(`
19:    CREATE TABLE personas (
20:      id TEXT PRIMARY KEY NOT NULL,
21:      name TEXT NOT NULL,
22:      system_prompt TEXT NOT NULL,
23:      provider TEXT NOT NULL,
24:      model TEXT NOT NULL,
25:      temperature REAL NOT NULL DEFAULT 0.7,
26:      created_at INTEGER NOT NULL,
27:      updated_at INTEGER NOT NULL
28:    );
29:    CREATE TABLE conversations (
30:      id TEXT PRIMARY KEY NOT NULL,
31:      persona_id TEXT NOT NULL REFERENCES personas(id) ON DELETE CASCADE,
32:      title TEXT NOT NULL,
33:      created_at INTEGER NOT NULL,
34:      updated_at INTEGER NOT NULL,
35:      archived_at INTEGER
36:    );
37:    CREATE TABLE messages (
38:      id TEXT PRIMARY KEY NOT NULL,
39:      conversation_id TEXT NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
40:      role TEXT NOT NULL,
41:      content TEXT NOT NULL,
42:      tokens INTEGER,
43:      created_at INTEGER NOT NULL
44:    );
45:  `)
46:  return drizzle(sqlite, { schema })
47:}
