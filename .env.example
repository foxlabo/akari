# Akari environment variables.
# Copy to .env.local and fill in the keys for the providers you want to use.
# Missing keys just disable that provider; the app still runs.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Ollama for local models. Default localhost.
OLLAMA_BASE_URL=http://localhost:11434

# Local SQLite database (relative paths are resolved from project root).
DATABASE_URL=file:./akari.db
